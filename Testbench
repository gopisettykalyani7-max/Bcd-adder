`timescale 1ns/1ps

module bcd_adder_tb;

reg [3:0] A;
reg [3:0] B;
reg Cin;

wire [3:0] Sum;
wire Cout;

bcd_adder uut (
    .A(A),
    .B(B),
    .Cin(Cin),
    .Sum(Sum),
    .Cout(Cout)
);

initial begin

    $dumpfile("bcd_adder.vcd");
    $dumpvars(0, bcd_adder_tb);

    $display("Time\tA\tB\tCin\tSum\tCout");
    $monitor("%0t\t%b\t%b\t%b\t%b\t%b",
              $time,A,B,Cin,Sum,Cout);


    // 5 + 3 = 8
    A = 4'b0101;
    B = 4'b0011;
    Cin = 0;
    #10;


    // 8 + 7 = 15
    A = 4'b1000;
    B = 4'b0111;
    Cin = 0;
    #10;


    // 9 + 9 = 18
    A = 4'b1001;
    B = 4'b1001;
    Cin = 0;
    #10;


    // 6 + 4 + carry = 11
    A = 4'b0110;
    B = 4'b0100;
    Cin = 1;
    #10;


    $finish;

end

endmodule